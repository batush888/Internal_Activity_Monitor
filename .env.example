# ==============================================================================
# PulseMatrix Pro — Environment & Secrets Configuration (.env)
# Copy this file to `.env` (`cp .env.example .env`). `.env` is ignored by Git.
# ==============================================================================

# --- App Bundle & Privacy ---
PULSEMATRIX_BUNDLE_ID="io.pulsematrix.pro"
# When true, masks your local hostname and macOS username in the UI and exported reports:
PULSEMATRIX_ANONYMIZE_HOST="true"
PULSEMATRIX_REDACTED_HOST_LABEL="apple-silicon-node.local"
PULSEMATRIX_REDACTED_USER_LABEL="developer"

# --- Local Prometheus & JSON Telemetry Exporter ---
PULSEMATRIX_PROMETHEUS_HOST="127.0.0.1"
PULSEMATRIX_PROMETHEUS_PORT="9101"
# Optional Bearer token required for /metrics and /api/v1/snapshot (leave empty for open localhost):
PULSEMATRIX_METRICS_API_KEY=""

# --- Optional Alert Webhook ---
PULSEMATRIX_WEBHOOK_URL=""

# --- Git & GitHub Repository Publishing (Used by scripts/publish_github.sh) ---
GIT_COMMIT_NAME="PulseMatrix Contributors"
GIT_COMMIT_EMAIL="noreply@users.noreply.github.com"
GITHUB_USERNAME=""
GITHUB_REPO_NAME="PulseMatrix-Pro"
GITHUB_REPO_VISIBILITY="public"
GITHUB_TOKEN=""
